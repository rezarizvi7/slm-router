    {
      "id": 13,
      "type": "bargauge",
      "title": "Complexity score distribution (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Cumulative share of requests at or below each score. The router threshold defaults to 0.5.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "expr": "sum by (le) (increase(router_complexity_score_bucket[$__range])) / ignoring(le) group_left sum(increase(router_complexity_score_count[$__range]))"
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
