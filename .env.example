# Copy to .env. Every setting in slm_router/config.py can be set as ROUTER_<NAME>.

ANTHROPIC_API_KEY=

# Frontier tier: "anthropic" (Messages API via the official SDK) or "openai_compat".
ROUTER_FRONTIER_PROVIDER=anthropic
ROUTER_FRONTIER_MODEL=claude-opus-5-5
ROUTER_FRONTIER_EFFORT=medium
# ROUTER_FRONTIER_PROVIDER=openai_compat
# ROUTER_FRONTIER_BASE_URL=https://openrouter.ai/api/v1
# ROUTER_FRONTIER_API_KEY=...
# ROUTER_FRONTIER_MODEL=...
# ROUTER_PRICING_JSON={"your-model": [input_usd_per_mtok, output_usd_per_mtok]}

# Local tier (Ollama, vLLM: http://localhost:8000/v1, llama.cpp server, ...)
ROUTER_LOCAL_MODEL=qwen2.5:1.5b-instruct
ROUTER_LOCAL_TTFT_BUDGET_S=3.0

# Routing
ROUTER_COMPLEXITY_THRESHOLD=0.5
ROUTER_JUDGE_ENABLED=true
ROUTER_CASCADE_ON_WEAK_ANSWER=true
ROUTER_FRONTIER_DAILY_BUDGET_USD=0

# Semantic cache
ROUTER_CACHE_MAX_DISTANCE=0.08
ROUTER_EMBED_MODEL=nomic-embed-text
